void drawLogo(vec2 p, float width, float front) {
    float m = width + 2.0; // a shape matters only near its bounding box
    if (p.x > 106.71 - m && p.x < 136.82 + m && p.y > 386.28 - m && p.y < 392.55 + m) {
        addShape(shape0(p), width, front, clamp((1491.56 - p.x) / 1384.85, 0.0, 1.0), 1.0);
    }
    if (p.x > 146.51 - m && p.x < 262.38 + m && p.y > 386.35 - m && p.y < 392.59 + m) {
        addShape(shape1(p), width, front, clamp((1491.56 - p.x) / 1384.85, 0.0, 1.0), 1.0);
    }
    if (p.x > 270.28 - m && p.x < 1491.56 + m && p.y > 386.35 - m && p.y < 392.56 + m) {
        addShape(shape2(p), width, front, clamp((1491.56 - p.x) / 1384.85, 0.0, 1.0), 1.0);
    }
    if (p.x > 825.99 - m && p.x < 1815.55 + m && p.y > 385.8 - m && p.y < 650.18 + m) {
        addShape(shape3(p), width, front, 0.0, 0.0);
    }
    if (p.x > 107.15 - m && p.x < 136.6 + m && p.y > 425.12 - m && p.y < 429.29 + m) {
        addShape(shape4(p), width, front, clamp((955.87 - p.x) / 848.71, 0.0, 1.0), 0.0);
    }
    if (p.x > 146.99 - m && p.x < 272.88 + m && p.y > 425.11 - m && p.y < 429.26 + m) {
        addShape(shape5(p), width, front, clamp((955.87 - p.x) / 848.71, 0.0, 1.0), 0.0);
    }
    if (p.x > 281.49 - m && p.x < 955.87 + m && p.y > 425.13 - m && p.y < 429.29 + m) {
        addShape(shape6(p), width, front, clamp((955.87 - p.x) / 848.71, 0.0, 1.0), 0.0);
    }
    if (p.x > 399.82 - m && p.x < 490.6 + m && p.y > 470.92 - m && p.y < 603.75 + m) {
        addShape(shape7(p), width, front, clamp((825.99 - p.x) / 717.35, 0.0, 1.0), 0.0);
    }
    if (p.x > 108.64 - m && p.x < 136.73 + m && p.y > 472.13 - m && p.y < 603.74 + m) {
        addShape(shape8(p), width, front, clamp((825.99 - p.x) / 717.35, 0.0, 1.0), 0.0);
    }
    if (p.x > 147.0 - m && p.x < 208.52 + m && p.y > 472.43 - m && p.y < 603.34 + m) {
        addShape(shape9(p), width, front, clamp((825.99 - p.x) / 717.35, 0.0, 1.0), 0.0);
    }
    if (p.x > 215.78 - m && p.x < 321.45 + m && p.y > 472.35 - m && p.y < 603.82 + m) {
        addShape(shape10(p), width, front, clamp((825.99 - p.x) / 717.35, 0.0, 1.0), 0.0);
    }
    if (p.x > 312.44 - m && p.x < 344.13 + m && p.y > 472.43 - m && p.y < 554.89 + m) {
        addShape(shape11(p), width, front, clamp((825.99 - p.x) / 717.35, 0.0, 1.0), 0.0);
    }
    if (p.x > 321.16 - m && p.x < 397.93 + m && p.y > 472.48 - m && p.y < 603.97 + m) {
        addShape(shape12(p), width, front, clamp((825.99 - p.x) / 717.35, 0.0, 1.0), 0.0);
    }
    if (p.x > 415.99 - m && p.x < 484.66 + m && p.y > 485.85 - m && p.y < 587.93 + m) {
        addShape(shape13(p), width, front, clamp((825.99 - p.x) / 717.35, 0.0, 1.0), 0.0);
    }
    if (p.x > 488.28 - m && p.x < 818.83 + m && p.y > 499.91 - m && p.y < 504.03 + m) {
        addShape(shape14(p), width, front, clamp((825.99 - p.x) / 717.35, 0.0, 1.0), 0.0);
    }
    if (p.x > 447.89 - m && p.x < 818.78 + m && p.y > 511.92 - m && p.y < 515.79 + m) {
        addShape(shape15(p), width, front, clamp((825.99 - p.x) / 717.35, 0.0, 1.0), 0.0);
    }
    if (p.x > 438.38 - m && p.x < 818.99 + m && p.y > 524.1 - m && p.y < 528.91 + m) {
        addShape(shape16(p), width, front, clamp((825.99 - p.x) / 717.35, 0.0, 1.0), 0.0);
    }
    if (p.x > 436.39 - m && p.x < 818.7 + m && p.y > 536.86 - m && p.y < 540.81 + m) {
        addShape(shape17(p), width, front, clamp((825.99 - p.x) / 717.35, 0.0, 1.0), 0.0);
    }
    if (p.x > 439.85 - m && p.x < 818.88 + m && p.y > 548.99 - m && p.y < 553.98 + m) {
        addShape(shape18(p), width, front, clamp((825.99 - p.x) / 717.35, 0.0, 1.0), 0.0);
    }
    if (p.x > 450.1 - m && p.x < 818.91 + m && p.y > 560.57 - m && p.y < 565.7 + m) {
        addShape(shape19(p), width, front, clamp((825.99 - p.x) / 717.35, 0.0, 1.0), 0.0);
    }
    if (p.x > 488.53 - m && p.x < 818.96 + m && p.y > 572.37 - m && p.y < 577.33 + m) {
        addShape(shape20(p), width, front, clamp((825.99 - p.x) / 717.35, 0.0, 1.0), 0.0);
    }
    if (p.x > 107.2 - m && p.x < 136.54 + m && p.y > 646.36 - m && p.y < 650.23 + m) {
        addShape(shape21(p), width, front, clamp((955.87 - p.x) / 848.71, 0.0, 1.0), 0.0);
    }
    if (p.x > 147.03 - m && p.x < 335.74 + m && p.y > 646.36 - m && p.y < 650.18 + m) {
        addShape(shape22(p), width, front, clamp((955.87 - p.x) / 848.71, 0.0, 1.0), 0.0);
    }
    if (p.x > 344.38 - m && p.x < 955.76 + m && p.y > 646.35 - m && p.y < 650.21 + m) {
        addShape(shape23(p), width, front, clamp((955.87 - p.x) / 848.71, 0.0, 1.0), 0.0);
    }
}

void main() {
    float t = Control.y;
    float k = Control.x;
    float keepBg = clamp(Params.x, 0.0, 1.0);
    float ringSize = clamp(Params.y, 0.0, 3.0);
    float draw = max(Params.z, 0.0);

    vec3 orig = texture(InSampler, texCoord).rgb;

    // fit the picture into the screen (keeps proportions, no cropping)
    float screenAsp = InSize.x / InSize.y;
    vec2 uv = texCoord - 0.5;
    if (screenAsp > IMAGE_ASPECT) {
        uv.x *= screenAsp / IMAGE_ASPECT;
    } else {
        uv.y *= IMAGE_ASPECT / screenAsp;
    }
    uv += 0.5;
    uv.y = 1.0 - uv.y; // picture rows go top -> bottom
    vec2 p = uv * IMAGE_SIZE;

    // size of one screen pixel in picture pixels (measured outside any branch)
    float pixel = max(fwidth(p.x), fwidth(p.y));
    float width = EDGE_SMOOTH * pixel;

    // growing front: everything with reveal time below the front is visible
    float progress = draw > 0.0001 ? clamp(t / draw, 0.0, 1.0) : 1.0;
    float front = progress * (1.0 + REVEAL_SOFT) + REVEAL_SOFT;

    gCover = 0.0;
    gRed = 0.0;
    drawLogo(p, width, front);

    vec3 tone = mix(WHITE, RED, gRed);
    vec3 c = mix(mix(orig, tone, gCover), tone * gCover, keepBg);

    // loading ring, bottom right corner (screen space, always round)
    if (ringSize > 0.0) {
        float u = InSize.y * ringSize;
        vec2 center = vec2(InSize.x - 0.07 * InSize.y, 0.07 * InSize.y);
        vec2 d = texCoord * InSize - center;
        float dist = length(d);
        float radius = 0.035 * u;
        float half_w = 0.005 * u;
        float aa = 1.0;
        float mask = 1.0 - smoothstep(half_w - aa, half_w + aa, abs(dist - radius));

        // rotating arc with a fading tail, 1.2 rotations per second
        float head = -t * 7.5;
        float diff = mod(head - atan(d.y, d.x), 6.2831853) / 6.2831853;
        float arc = pow(1.0 - diff, 2.0);
        float ring = mask * mix(0.15, 1.0, arc);

        c = mix(c, Color.rgb, ring);
    }

    fragColor = vec4(mix(orig, c, clamp(k, 0.0, 1.0)), 1.0);
}
